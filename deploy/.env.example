# Copie para .env e ajuste. NUNCA comitar o .env real (segredos fora do código — brief §10).

# Postgres (control plane + backend de dados do Stalwart)
POSTGRES_USER=mailin
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=mailin

# Stalwart — admin GLOBAL. Só o backend Go usa. Nunca vaza para o frontend.
STALWART_ADMIN_SECRET=change-me-stalwart-admin
# Hostname/domínio usados no bootstrap do Stalwart.
STALWART_HOSTNAME=mail.localhost
STALWART_DEFAULT_DOMAIN=localhost

# Dev local: domínios de teste não resolvem DNS — pule a verificação para provisionar.
PROVISION_SKIP_DNS_VERIFY=true

# MinIO (blobs do serviço de arquivos)
MINIO_ROOT_USER=mailin
MINIO_ROOT_PASSWORD=change-me-minio

# IA — provider genérico (troca por config). DeepSeek v4 hoje; Claude/OpenAI no futuro.
# A chave fica SÓ no backend, nunca no frontend.
AI_PROVIDER=deepseek
AI_API_KEY=change-me-deepseek-key
AI_MODEL=deepseek-v4
# AI_BASE_URL=https://api.deepseek.com   # opcional (default do provider)

# SMS (MFA) — provider genérico. "log" (dev, imprime o código) por padrão; Twilio etc. depois.
SMS_PROVIDER=log

# Billing — "manual" (dev, aplica o plano na hora) ou "stripe" (produção).
BILLING_PROVIDER=manual
# Planos são POR USUÁRIO. Moeda: BRL | EUR | USD (conforme o país).
BILLING_CURRENCY=BRL
# Mínimo de usuários cobrados em planos pagos (ex.: cobrar ao menos 5 seats).
BILLING_MIN_PAID_USERS=1
STRIPE_SECRET_KEY=sk_test_or_live_key_here   # real vai em deploy/secrets.env (git-ignored)
# STRIPE_WEBHOOK_SECRET=whsec_...

# Obs.: MINIO_ENDPOINT/ACCESS/SECRET/BUCKET são injetados pelo docker-compose (serviço 'api'),
# apontando para o serviço interno 'minio'. Não precisa defini-los aqui.

# ─────────────────────────────────────────────────────────────────────────────
# Segurança / produção
# ─────────────────────────────────────────────────────────────────────────────

# Ambiente. "development" (default) roda com defaults permissivos (dev). Em "production" a config
# FALHA FECHADO no arranque: recusa subir com segredo vazio, fraco (<16 chars) ou um default de dev
# conhecido, e exige COOKIE_SECURE=true e NOTIFY_SMTP_INSECURE=false. Deixe em produção:
#   APP_ENV=production
APP_ENV=development

# Cifra do segredo TOTP (2º fator) em repouso, com AES-256-GCM. Sem esta chave o segredo fica em
# CLARO no banco — aceitável só em dev. Em produção, defina uma chave forte e ESTÁVEL (trocá-la
# invalida os TOTP já cadastrados). Gere com: openssl rand -base64 48
# MFA_ENC_KEY=change-me-strong-random-key

# Cookie de sessão como SameSite=None; Secure — obrigatório em produção HTTPS (e cross-site/Tauri).
# Em dev (http) deixe false. Em produção (APP_ENV=production) tem de ser true, senão o boot falha.
COOKIE_SECURE=false

# ─────────────────────────────────────────────────────────────────────────────
# OnlyOffice Document Server — conformidade AGPL
# ─────────────────────────────────────────────────────────────────────────────

# Corremos a imagem oficial do Document Server MODIFICADA no arranque (patch de branding, em
# deploy/onlyoffice-branding-patch.sh) para o cabeçalho do editor levar a marca Beskos. A AGPL v3
# §13 obriga a oferecer o fonte dessas modificações a quem usa o editor pela rede: este endereço
# aparece no diálogo "Sobre" do editor, junto da atribuição à Ascensio System SIA.
# Em APP_ENV=production o boot FALHA sem ele. Aponte para o repositório público do patch.
ONLYOFFICE_SOURCE_URL=https://github.com/denerFernandes/beskos-docs-server
