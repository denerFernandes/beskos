<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements do app macOS. Câmara/microfone para as videochamadas do Meet (WKWebView). Aplicados
     na assinatura (ad-hoc por omissão); necessários quando o app for assinado/notarizado com hardened
     runtime. As descrições de uso ficam no Info.plist. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
