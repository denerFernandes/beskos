<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Chaves extra do Info.plist mescladas pelo Tauri no bundle macOS. As descrições de uso são
     OBRIGATÓRIAS para o WKWebView poder pedir câmara/microfone (getUserMedia) no Meet — sem elas o
     macOS nega em silêncio e a sala abre sem vídeo/áudio. -->
<plist version="1.0">
<dict>
  <key>NSCameraUsageDescription</key>
  <string>O Beskos usa a câmara nas videochamadas do Meet.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>O Beskos usa o microfone nas videochamadas do Meet.</string>
  <!-- App Transport Security: a WKWebView bloqueia HTTP cleartext por omissão, e a app corre num
       contexto seguro (tauri://localhost). Em DEV o backend está em http://localhost:8000, por isso
       sem esta exceção os pedidos falham em silêncio ("Servidor indisponível"). A exceção é RESTRITA
       a localhost — em produção o backend é HTTPS e nada disto se aplica. -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
    <key>NSExceptionDomains</key>
    <dict>
      <key>localhost</key>
      <dict>
        <key>NSExceptionAllowsInsecureHTTPLoads</key>
        <true/>
        <key>NSIncludesSubdomains</key>
        <true/>
      </dict>
    </dict>
  </dict>
</dict>
</plist>
