# Variáveis de ambiente do frontend. São EMBUTIDAS EM TEXTO CLARO no pacote (web/desktop/mobile),
# por isso NÃO PODEM ser segredos — são só URLs públicas do servidor.
#
# - Web/dev: deixe VAZIAS. As chamadas ficam relativas e o proxy (Vite/Caddy) trata /api e /jmap.
# - App Tauri empacotado: defina a URL pública do servidor (não há proxy no pacote).
#     VITE_API_BASE=https://app.suaempresa.com
#
# NUNCA coloque chaves/segredos aqui nem em nenhuma variável VITE_ — o build falha de propósito
# (ver vite.config.ts). Segredos (IA, admin do Stalwart, base de dados, VAPID privado) vivem só no
# backend Go e nunca são enviados ao frontend.
VITE_API_BASE=

# Origem PÚBLICA da app web, usada nos links PARTILHÁVEIS gerados pelo app nativo (convite de
# reunião /j/<sala>, links em e-mails, partilhas). No desktop a origem local é tauri://localhost —
# inútil para terceiros. Sem esta var, cai em VITE_API_BASE (em produção o Caddy serve SPA e API na
# mesma origem, então costuma bastar).
#     VITE_PUBLIC_BASE=https://app.suaempresa.com
VITE_PUBLIC_BASE=
